{"transcript":"ˈdat͡ɕːɪk ˈdɨmə","exists":true,"definitions":["Устройство, обнаруживающее наличие дыма, обычно как индикатор пожара.","Прибор для регистрации продуктов горения в воздухе."],"examples":["Установили датчик дыма на потолке.","Датчик дыма сработал вовремя.","Проверка датчика дыма обязательна."],"lemma":"датчик дыма","lemmaPos":"noun","synonyms":["дымовой извещатель","пожарный извещатель"],"number":"singular","pluralForm":"датчики дыма","gender":"masculine","source":"датчик дыма","frequency":4}