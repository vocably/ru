{"transcript":"ɐˈbʲɵrtkə","exists":true,"definitions":["Материал, используемый для упаковки чего-либо.","Наружный слой упаковки.","Бумага или другой материал, в который что-либо завёрнуто."],"examples":["Я выбросил обёртку от конфеты.","Красивая обёртка привлекает внимание.","Он развернул обёртку и достал подарок."],"lemma":"обёртка","lemmaPos":"noun","synonyms":["упаковка","фантик","обёртка"],"number":"singular","pluralForm":"обёртки","gender":"feminine","source":"обёртка","frequency":5}