{"transcript":"pəɡlɐˈtʲitʲ","exists":true,"definitions":["Впитать, вобрать в себя что-либо.","Занять целиком, полностью охватить.","Уничтожить, истребить, погубить.","Съесть, выпить что-либо очень быстро или в большом количестве."],"examples":["Губка поглотила воду.","Работа полностью поглотила его.","Пламя поглотило старый дом.","Он поглотил обед за пять минут."],"lemma":"поглотить","lemmaPos":"verb","synonyms":["впитать","вбрать","занять","охватить","уничтожить","съесть"],"number":"singular","tense":"future","source":"поглотить","frequency":4}