{"transcript":"sʲɪˈkundə","exists":true,"definitions":["Единица измерения времени, равная 1/60 минуты.","Единица измерения угла, равная 1/60 минуты дуги.","Момент, очень короткий промежуток времени."],"examples":["Подожди одну секунду.","Каждая секунда на счету.","Через секунду он исчез."],"lemma":"секунда","lemmaPos":"noun","synonyms":["миг","мгновение","момент"],"number":"singular","pluralForm":"секунды","gender":"feminine","source":"секунда","frequency":9}