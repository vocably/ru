{"transcript":"dvor","exists":true,"definitions":["Участок земли, примыкающий к дому или строению, обычно огороженный.","Крестьянское хозяйство, дворня.","Королевский или императорский двор, монарх и его окружение."],"examples":["Дети играют во дворе.","Наш двор очень большой.","Королевский двор собрался на бал."],"lemma":"двор","lemmaPos":"noun","synonyms":["дворик","усадьба","резиденция"],"number":"singular","pluralForm":"дворы","gender":"masculine","source":"двор","frequency":8}