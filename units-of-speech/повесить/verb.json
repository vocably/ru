{"transcript":"pɐˈvʲesʲɪtʲ","exists":true,"definitions":["Закрепить что-либо в висячем положении.","Лишить жизни через повешение.","Перен. Возложить что-либо на кого-либо (обязанности, вину и т.п.)."],"examples":["Повесить картину на стену.","Повесить белье сушиться.","Повесить трубку телефона.","Повесить вину на другого."],"lemma":"повесить","lemmaPos":"verb","synonyms":["подвесить","закрепить","казнить"],"number":"singular","tense":"future","source":"повесить"}