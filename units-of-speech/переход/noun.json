{"transcript":"pʲɪrʲɪˈxot","exists":true,"definitions":["Действие по значению глагола переходить — перемещение куда-либо, через что-либо.","Место, приспособленное для перехода.","Перемена, смена одного состояния другим.","Музыкальная фраза, связывающая две части произведения."],"examples":["Пешеходный переход.","Подземный переход.","Переход на летнее время.","Плавный переход."],"lemma":"переход","lemmaPos":"noun","synonyms":["перемещение","смена","путь","перемена"],"number":"singular","pluralForm":"переходы","gender":"masculine","source":"переход","frequency":7}