{"transcript":"mʲɪdˈvʲetʲ","exists":true,"definitions":["Крупное хищное млекопитающее с густой шерстью, обитающее в лесах.","Переносное значение: неуклюжий, неповоротливый человек."],"examples":["Бурый медведь спит зимой.","Медведь вышел из берлоги.","Он был как медведь в посудной лавке."],"lemma":"медведь","lemmaPos":"noun","synonyms":["мишка","топтыгин"],"number":"singular","pluralForm":"медведи","gender":"masculine","source":"медведь"}