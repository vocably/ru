{"transcript":"pəbʲɪʐˈdatʲ","exists":true,"definitions":["Одерживать победу над кем-либо или чем-либо.","Преодолевать трудности, препятствия.","Выигрывать в соревновании, борьбе."],"examples":["Он всегда побеждает в спорах.","Мы должны побеждать свои страхи.","Команда побеждает в каждом матче."],"lemma":"побеждать","lemmaPos":"verb","synonyms":["выигрывать","одолевать","превосходить"],"number":"singular","tense":"present","source":"побеждать","frequency":6}