{"transcript":"vɨnʊʐˈdatʲ","exists":true,"definitions":["Заставлять кого-либо делать что-либо против его воли.","Принуждать к какому-либо действию или состоянию."],"examples":["Обстоятельства вынуждают его уехать.","Она вынуждает меня говорить правду.","Мы вынуждены были согласиться."],"lemma":"вынуждать","lemmaPos":"verb","synonyms":["заставлять","принуждать","обязывать"],"number":"singular","tense":"present","source":"вынуждать"}