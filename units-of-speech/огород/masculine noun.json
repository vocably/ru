{"transcript":"ɐɡɐˈrot","exists":true,"definitions":["Участок земли, обычно при доме, используемый для выращивания овощей, фруктов или ягод.","Место, где выращивают овощи."],"examples":["Работать в огороде.","Свой огород.","Огород за домом."],"lemma":"огород","lemmaPos":"noun","synonyms":["грядка","участок"],"number":"singular","pluralForm":"огороды","gender":"masculine","source":"огород"}