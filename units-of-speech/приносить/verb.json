{"transcript":"prʲɪnɐˈsʲitʲ","exists":true,"definitions":["Доставлять что-либо куда-либо, обычно неся в руках.","Быть причиной чего-либо, приводить к какому-либо результату.","Давать урожай, плоды (о растениях)."],"examples":["Приносить пользу.","Приносить извинения.","Приносить присягу."],"lemma":"приносить","lemmaPos":"verb","synonyms":["доставлять","приводить","давать"],"number":"singular","tense":"present","source":"приносить"}