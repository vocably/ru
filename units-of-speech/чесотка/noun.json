{"transcript":"t͡ɕɪˈsotkə","exists":true,"definitions":["Кожное заболевание, вызываемое чесоточным клещом, характеризующееся зудом и высыпаниями.","Сильный зуд, желание чесаться."],"examples":["У него была чесотка.","Чесотка не давала ему спать.","Избавиться от чесотки."],"lemma":"чесотка","lemmaPos":"noun","synonyms":["зуд","скабиес"],"number":"singular","pluralForm":"чесотки","gender":"feminine","source":"чесотка"}